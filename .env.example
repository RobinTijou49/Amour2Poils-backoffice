# Copier ce fichier en .env puis adapter les valeurs.
# .env n'est jamais commité (voir .gitignore).

# Base de données (doit correspondre à docker-compose.yml)
POSTGRES_USER=amour2poils
POSTGRES_PASSWORD=amour2poils
POSTGRES_DB=amour2poils
DATABASE_URL="postgresql://amour2poils:amour2poils@localhost:5433/amour2poils?schema=public"

# Compte administrateur créé par le seed (développement uniquement)
SEED_ADMIN_EMAIL=admin@amour2poils.test
SEED_ADMIN_PASSWORD=change-moi-en-local

# Compte employé créé par le seed (développement uniquement)
SEED_EMPLOYEE_EMAIL=employe@amour2poils.test
SEED_EMPLOYEE_PASSWORD=change-moi-aussi

# Compte de test (gérance) créé par le seed (développement uniquement)
SEED_TEST_EMAIL=test@test.fr
SEED_TEST_PASSWORD=test1234

# Notifications push : générer les clés avec `bunx web-push generate-vapid-keys`
# La clé privée et CRON_SECRET ne doivent jamais être exposées au navigateur.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@amour2poils.test
# Secret du cron qui appelle /api/push/rappels-vaccins (en-tête Authorization: Bearer ...)
CRON_SECRET=
