# Modèle des variables de production. Copier en `.env.production` sur le VPS (ce fichier n'est jamais commité).
# Mots de passe : lettres, chiffres, `-` et `_` uniquement (ils sont insérés dans l'URL de connexion).
# Générer un secret : `openssl rand -base64 24 | tr '+/' '-_' | tr -d '='`

POSTGRES_USER=amour2poils
POSTGRES_PASSWORD=
POSTGRES_DB=amour2poils

# Notifications push : `bunx web-push generate-vapid-keys` (la clé privée ne quitte jamais le serveur)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Secret du cron qui appelle POST /api/push/rappels-vaccins (en-tête Authorization: Bearer ...)
CRON_SECRET=

# Image publiée par la CI (nom en minuscules) et version déployée
IMAGE_REPO=ghcr.io/robintijou49/amour2poils-backoffice
TAG=latest
