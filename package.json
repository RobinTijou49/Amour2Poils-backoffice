{
  "name": "amour2poils-backoffice",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "eslint",
    "typecheck": "bun --bun next typegen && tsc --noEmit",
    "test": "bun test src",
    "test:watch": "bun test src --watch",
    "test:db": "bun tests/db-setup.ts",
    "test:int": "bun test --preload ./tests/integration/setup.ts tests/integration",
    "test:components": "bun test --preload ./tests/components/setup.ts tests/components",
    "test:e2e": "bun run build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "bun run test && bun run test:db && bun run test:int && bun run test:components",
    "postinstall": "bun --bun prisma generate",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "bun --bun prisma migrate dev",
    "db:generate": "bun --bun prisma generate",
    "db:seed": "bun --bun prisma db seed",
    "db:reset": "bun --bun prisma migrate reset",
    "db:studio": "bun --bun prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bun": "^1.4.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "happy-dom": "^21.0.4",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "typescript": "^7"
  },
  "packageManager": "bun@1.4.4",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
